# Local dev (SQLite)
DATABASE_URL="file:./dev.db"
# Production (Hostinger MySQL) — also run `npm run db:use-mysql` before migrating
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"
CRON_SECRET="change-me"

# Public address of the app (used in email links), e.g. https://crm.yourdomain.com
APP_URL="http://localhost:3000"

# Outgoing email (Hostinger mailbox: smtp.hostinger.com, port 465)
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="crm@yourdomain.com"
# SMTP_PASS=""
# SMTP_FROM="The Advisor Associates <crm@yourdomain.com>"

# Facebook / Instagram Lead Ads
# FB_APP_SECRET=""      # Meta app secret (verifies webhook signatures)
# FB_PAGE_TOKEN=""      # Page access token with leads_retrieval

# Company timezone for attendance, leave and reports (default Asia/Karachi)
# APP_TIMEZONE="Asia/Karachi"
# Daily job URL for Hostinger cron: /api/cron/daily?key=<CRON_SECRET>

# Calls softphone: key that encrypts agents' Issabel extension passwords (any long random string; keep it secret
# and don't change it later, or the passwords must be entered again). Falls back to CRON_SECRET if unset.
# SIP_SECRET_KEY=
