// Local dev: SQLite. Production (Hostinger): MySQL — run `npm run db:use-mysql`.
// Fields marked `// @text` become @db.Text on MySQL (long content).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Organization ────────────────────────────────────────────

model Branch {
  id        String    @id @default(cuid())
  name      String    @unique
  code      String    @unique
  address   String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  users     User[]
  leads     Lead[]
  deals     Deal[]
  contacts  Contact[]
  companies Company[]
  units     Unit[]
}

// ─── Users, roles & permissions ──────────────────────────────

model User {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  phone             String?
  title             String?
  passwordHash      String
  active            Boolean        @default(true)
  isSuperAdmin      Boolean        @default(false)
  branchId          String?
  branch            Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  managerId         String?
  manager           User?          @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports           User[]         @relation("Reports")
  roles             UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  ownedLeads        Lead[]         @relation("LeadOwner")
  createdLeads      Lead[]         @relation("LeadCreator")
  ownedDeals        Deal[]         @relation("DealOwner")
  ownedContacts     Contact[]      @relation("ContactOwner")
  ownedCompanies    Company[]      @relation("CompanyOwner")
  activities        Activity[]     @relation("ActivityOwner")
  createdActivities Activity[]     @relation("ActivityCreator")
  listings          Unit[]         @relation("UnitOwner")
  /// Appearance: null = use company default
  theme             String?
  accent            String?
  wallpaper         String?
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([branchId])
  @@index([managerId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime     @default(now())
}

/// One row per (role, module, action). scope: none | own | team | branch | all
model Permission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module String
  action String
  scope  String

  @@unique([roleId, module, action])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Platform ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String // @text
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String? // @text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Setting {
  key   String @id
  value String // @text
}

// ─── CRM config ──────────────────────────────────────────────

model LeadSource {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  leads     Lead[]
  deals     Deal[]
  contacts  Contact[]
}

/// kind: open | converted | junk
model LeadStatus {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String  @default("slate")
  kind      String  @default("open")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  leads     Lead[]
}

model Pipeline {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  isDefault Boolean @default(false)
  stages    Stage[]
  deals     Deal[]
}

/// kind: open | won | lost
model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("slate")
  kind        String   @default("open")
  probability Int      @default(0)
  sortOrder   Int      @default(0)
  /// Unit status applied to linked units when a deal enters this stage (null = release hold)
  unitStatus  String?
  deals       Deal[]

  @@index([pipelineId])
}

// ─── CRM records ─────────────────────────────────────────────
// Every scoped record has ownerId + branchId so own/team/branch permissions apply.

model Lead {
  id             String      @id @default(cuid())
  name           String
  phone          String?
  phoneKey       String?
  phone2         String?
  email          String?
  sourceId       String?
  source         LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  campaign       String?
  interest       String? // buy | rent | invest | sell
  propertyType   String?
  location       String?
  budgetMin      Float?
  budgetMax      Float?
  notes          String? // @text
  statusId       String
  status         LeadStatus  @relation(fields: [statusId], references: [id])
  ownerId        String?
  owner          User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?       @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  convertedAt    DateTime?
  lastActivityAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deals          Deal[]
  activities     Activity[]

  @@index([ownerId])
  @@index([branchId])
  @@index([statusId])
  @@index([phoneKey])
  @@index([createdAt])
}

model Company {
  id         String     @id @default(cuid())
  name       String
  phone      String?
  email      String?
  industry   String?
  address    String?
  notes      String? // @text
  ownerId    String?
  owner      User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@index([ownerId])
}

model Contact {
  id         String      @id @default(cuid())
  name       String
  phone      String?
  phoneKey   String?
  phone2     String?
  email      String?
  cnic       String?
  address    String?
  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceId   String?
  source     LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  notes      String? // @text
  ownerId    String?
  owner      User?       @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  leads      Lead[]
  deals      Deal[]
  activities Activity[]

  @@index([ownerId])
  @@index([phoneKey])
}

model Deal {
  id             String       @id @default(cuid())
  title          String
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id])
  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sourceId       String?
  source         LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  value          Float?
  commissionPct  Float?
  expectedClose  DateTime?
  lostReason     String?
  notes          String? // @text
  ownerId        String?
  owner          User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stageChangedAt DateTime     @default(now())
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  units          DealUnit[]
  paymentPlan    PaymentPlan?

  @@index([ownerId])
  @@index([branchId])
  @@index([stageId])
}

/// type: note | call | meeting | visit | task | email | system
/// Tasks/meetings/visits have dueAt; doneAt marks completion.
model Activity {
  id          String    @id @default(cuid())
  type        String
  subject     String
  body        String? // @text
  dueAt       DateTime?
  doneAt      DateTime?
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?     @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  branchId    String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([dealId])
  @@index([contactId])
  @@index([ownerId, dueAt])
}

// ─── Inventory ───────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  name              String   @unique
  code              String?
  developer         String?
  location          String?
  city              String   @default("Karachi")
  kind              String   @default("residential") // residential | commercial | mixed
  status            String   @default("active") // upcoming | active | completed
  description       String? // @text
  /// Default payment plan offered for this project
  planDownPct       Float?
  planInstallments  Int?
  planFrequency     String? // monthly | quarterly | biannual
  planPossessionPct Float?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  blocks            Block[]
  units             Unit[]
}

model Block {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  units     Unit[]

  @@unique([projectId, name])
}

/// listingType: project (company stock) | resale | rental (agent listings)
/// status: available | hold | booked | sold | rented | offmarket
model Unit {
  id                 String      @id @default(cuid())
  listingType        String      @default("project")
  purpose            String      @default("sale") // sale | rent
  projectId          String?
  project            Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  blockId            String?
  block              Block?      @relation(fields: [blockId], references: [id], onDelete: SetNull)
  unitNo             String
  type               String
  size               Float?
  sizeUnit           String      @default("sqft") // marla | kanal | sqft | sqyd
  bedrooms           Int?
  bathrooms          Int?
  floor              String?
  facing             String?
  corner             Boolean     @default(false)
  parkFacing         Boolean     @default(false)
  mainRoad           Boolean     @default(false)
  price              Float?
  status             String      @default("available")
  address            String?
  lat                Float?
  lng                Float?
  propertyOwner      String?
  propertyOwnerPhone String?
  notes              String? // @text
  ownerId            String?
  owner              User?       @relation("UnitOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId           String?
  branch             Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// The deal currently holding this unit (booked/sold through it)
  activeDealId       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  images             UnitImage[]
  deals              DealUnit[]

  @@index([projectId])
  @@index([status])
  @@index([ownerId])
}

model UnitImage {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model DealUnit {
  dealId    String
  unitId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([dealId, unitId])
}

model PaymentPlan {
  id            String        @id @default(cuid())
  dealId        String        @unique
  deal          Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  total         Float
  downPct       Float
  installments  Int
  frequency     String // monthly | quarterly | biannual
  possessionPct Float         @default(0)
  startDate     DateTime
  createdAt     DateTime      @default(now())
  items         Installment[]
}

model Installment {
  id         String      @id @default(cuid())
  planId     String
  plan       PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  seq        Int
  label      String
  dueDate    DateTime
  amount     Float
  paidAmount Float       @default(0)
  paidAt     DateTime?
  method     String?
  reference  String?

  @@index([planId])
  @@index([dueDate])
}

// ─── Messaging & integrations ────────────────────────────────

/// status: sent | failed | skipped (SMTP not configured)
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String // @text
  status    String
  error     String?
  userId    String?
  leadId    String?
  dealId    String?
  contactId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// source: webform | facebook. status: created | merged | ignored | error
model WebhookLog {
  id        String   @id @default(cuid())
  source    String
  status    String
  summary   String // @text
  leadId    String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}
