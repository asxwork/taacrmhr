// Local dev: SQLite. Production (Hostinger): MySQL — run `npm run db:use-mysql`.
// Fields marked `// @text` become @db.Text on MySQL (long content).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Organization ────────────────────────────────────────────

model Branch {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String     @unique
  address   String?
  lat       Float?
  lng       Float?
  radiusM   Int        @default(150)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  users     User[]
  leads     Lead[]
  deals     Deal[]
  contacts  Contact[]
  companies Company[]
  units     Unit[]
  employees Employee[]
}

// ─── Users, roles & permissions ──────────────────────────────

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  phone             String?
  title             String?
  passwordHash      String
  active            Boolean           @default(true)
  isSuperAdmin      Boolean           @default(false)
  branchId          String?
  branch            Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  managerId         String?
  manager           User?             @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports           User[]            @relation("Reports")
  roles             UserRole[]
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  ownedLeads        Lead[]            @relation("LeadOwner")
  createdLeads      Lead[]            @relation("LeadCreator")
  ownedDeals        Deal[]            @relation("DealOwner")
  ownedContacts     Contact[]         @relation("ContactOwner")
  ownedCompanies    Company[]         @relation("CompanyOwner")
  activities        Activity[]        @relation("ActivityOwner")
  createdActivities Activity[]        @relation("ActivityCreator")
  listings          Unit[]            @relation("UnitOwner")
  /// Appearance: null = use company default
  theme             String?
  accent            String?
  wallpaper         String?
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  employee          Employee?
  approvalRequests  ApprovalRequest[]
  approvalActions   ApprovalAction[]

  @@index([branchId])
  @@index([managerId])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  permissions Permission[]
  users       UserRole[]
  createdAt   DateTime     @default(now())
}

/// One row per (role, module, action). scope: none | own | team | branch | all
model Permission {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module String
  action String
  scope  String

  @@unique([roleId, module, action])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Platform ────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String // @text
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String? // @text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model Setting {
  key   String @id
  value String // @text
}

// ─── CRM config ──────────────────────────────────────────────

model LeadSource {
  id        String    @id @default(cuid())
  name      String    @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  leads     Lead[]
  deals     Deal[]
  contacts  Contact[]
}

/// kind: open | converted | junk
model LeadStatus {
  id        String  @id @default(cuid())
  name      String  @unique
  color     String  @default("slate")
  kind      String  @default("open")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  leads     Lead[]
}

model Pipeline {
  id        String  @id @default(cuid())
  name      String  @unique
  sortOrder Int     @default(0)
  isDefault Boolean @default(false)
  stages    Stage[]
  deals     Deal[]
}

/// kind: open | won | lost
model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("slate")
  kind        String   @default("open")
  probability Int      @default(0)
  sortOrder   Int      @default(0)
  /// Unit status applied to linked units when a deal enters this stage (null = release hold)
  unitStatus  String?
  deals       Deal[]

  @@index([pipelineId])
}

// ─── CRM records ─────────────────────────────────────────────
// Every scoped record has ownerId + branchId so own/team/branch permissions apply.

model Lead {
  id             String      @id @default(cuid())
  /// Permanent, ever-increasing number shown as the lead ID. Never reused, even after deletes.
  number         Int?
  name           String
  phone          String?
  phoneKey       String?
  phone2         String?
  email          String?
  sourceId       String?
  source         LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  campaign       String?
  /// Where exactly the lead came from, e.g. the Zameen ad title or the Facebook form.
  sourceInfo     String? // @text
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  interest       String? // buy | rent | invest | sell
  propertyType   String?
  location       String?
  budgetMin      Float?
  budgetMax      Float?
  notes          String? // @text
  statusId       String
  status         LeadStatus  @relation(fields: [statusId], references: [id])
  ownerId        String?
  owner          User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?       @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  convertedAt    DateTime?
  lastActivityAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deals          Deal[]
  activities     Activity[]

  @@index([ownerId])
  @@index([branchId])
  @@index([projectId])
  @@index([number])
  @@index([statusId])
  @@index([phoneKey])
  @@index([createdAt])
}

model Company {
  id         String     @id @default(cuid())
  name       String
  phone      String?
  email      String?
  industry   String?
  address    String?
  notes      String? // @text
  ownerId    String?
  owner      User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  @@index([ownerId])
}

model Contact {
  id         String      @id @default(cuid())
  name       String
  phone      String?
  phoneKey   String?
  phone2     String?
  email      String?
  cnic       String?
  address    String?
  companyId  String?
  company    Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sourceId   String?
  source     LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  notes      String? // @text
  ownerId    String?
  owner      User?       @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  leads      Lead[]
  deals      Deal[]
  activities Activity[]

  @@index([ownerId])
  @@index([phoneKey])
}

model Deal {
  id             String       @id @default(cuid())
  title          String
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id])
  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sourceId       String?
  source         LeadSource?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  value          Float?
  commissionPct  Float?
  expectedClose  DateTime?
  lostReason     String?
  notes          String? // @text
  ownerId        String?
  owner          User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  stageChangedAt DateTime     @default(now())
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  units          DealUnit[]
  paymentPlan    PaymentPlan?

  @@index([ownerId])
  @@index([branchId])
  @@index([stageId])
}

/// type: note | call | meeting | visit | task | email | system
/// Tasks/meetings/visits have dueAt; doneAt marks completion.
model Activity {
  id          String    @id @default(cuid())
  type        String
  subject     String
  body        String? // @text
  dueAt       DateTime?
  doneAt      DateTime?
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?     @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  branchId    String?
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([dealId])
  @@index([contactId])
  @@index([ownerId, dueAt])
}

// ─── Inventory ───────────────────────────────────────────────

model Project {
  id                String   @id @default(cuid())
  name              String   @unique
  code              String?
  developer         String?
  location          String?
  city              String   @default("Karachi")
  kind              String   @default("residential") // residential | commercial | mixed
  status            String   @default("active") // upcoming | active | completed
  description       String? // @text
  /// Default payment plan offered for this project
  planDownPct       Float?
  planInstallments  Int?
  planFrequency     String? // monthly | quarterly | biannual
  planPossessionPct Float?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  blocks            Block[]
  units             Unit[]
  leads             Lead[]
}

model Block {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)
  units     Unit[]

  @@unique([projectId, name])
}

/// listingType: project (company stock) | resale | rental (agent listings)
/// status: available | hold | booked | sold | rented | offmarket
model Unit {
  id                 String      @id @default(cuid())
  listingType        String      @default("project")
  purpose            String      @default("sale") // sale | rent
  projectId          String?
  project            Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  blockId            String?
  block              Block?      @relation(fields: [blockId], references: [id], onDelete: SetNull)
  unitNo             String
  type               String
  size               Float?
  sizeUnit           String      @default("sqft") // marla | kanal | sqft | sqyd
  bedrooms           Int?
  bathrooms          Int?
  floor              String?
  facing             String?
  corner             Boolean     @default(false)
  parkFacing         Boolean     @default(false)
  mainRoad           Boolean     @default(false)
  price              Float?
  status             String      @default("available")
  address            String?
  lat                Float?
  lng                Float?
  propertyOwner      String?
  propertyOwnerPhone String?
  notes              String? // @text
  ownerId            String?
  owner              User?       @relation("UnitOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  branchId           String?
  branch             Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  /// The deal currently holding this unit (booked/sold through it)
  activeDealId       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  images             UnitImage[]
  deals              DealUnit[]

  @@index([projectId])
  @@index([status])
  @@index([ownerId])
}

model UnitImage {
  id        String   @id @default(cuid())
  unitId    String
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model DealUnit {
  dealId    String
  unitId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([dealId, unitId])
}

model PaymentPlan {
  id            String        @id @default(cuid())
  dealId        String        @unique
  deal          Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  total         Float
  downPct       Float
  installments  Int
  frequency     String // monthly | quarterly | biannual
  possessionPct Float         @default(0)
  startDate     DateTime
  createdAt     DateTime      @default(now())
  items         Installment[]
}

model Installment {
  id         String      @id @default(cuid())
  planId     String
  plan       PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  seq        Int
  label      String
  dueDate    DateTime
  amount     Float
  paidAmount Float       @default(0)
  paidAt     DateTime?
  method     String?
  reference  String?

  @@index([planId])
  @@index([dueDate])
}

// ─── Messaging & integrations ────────────────────────────────

/// status: sent | failed | skipped (SMTP not configured)
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String // @text
  status    String
  error     String?
  userId    String?
  leadId    String?
  dealId    String?
  contactId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// source: webform | facebook. status: created | merged | ignored | error
model WebhookLog {
  id        String   @id @default(cuid())
  source    String
  status    String
  summary   String // @text
  leadId    String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// ─── HR: organisation & employees ───────────────────────────

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  code      String?
  headId    String?
  active    Boolean    @default(true)
  sortOrder Int        @default(0)
  employees Employee[]
}

model Designation {
  id        String     @id @default(cuid())
  name      String     @unique
  grade     String?
  active    Boolean    @default(true)
  employees Employee[]
}

/// status: probation | active | notice | left. Scope fields: userId (own/team), branchId (branch).
model Employee {
  id                String             @id @default(cuid())
  code              String             @unique
  userId            String?            @unique
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName          String
  fatherName        String?
  gender            String?
  dob               DateTime?
  cnic              String?
  cnicExpiry        DateTime?
  maritalStatus     String?
  bloodGroup        String?
  phone             String?
  personalEmail     String?
  address           String?
  city              String?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?
  bankName          String?
  accountTitle      String?
  accountNumber     String?
  photo             String?
  joiningDate       DateTime
  employmentType    String             @default("permanent") // permanent | contract | intern | consultant
  status            String             @default("probation")
  probationEnd      DateTime?
  confirmedAt       DateTime?
  noticeDate        DateTime?
  lastWorkingDay    DateTime?
  exitType          String? // resigned | terminated | other
  exitReason        String?
  leftAt            DateTime?
  departmentId      String?
  department        Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId     String?
  designation       Designation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  branchId          String?
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shiftId           String?
  shift             Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  deviceUserId      String?            @unique
  managerId         String?
  manager           Employee?          @relation("EmployeeReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]         @relation("EmployeeReports")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  events            EmployeeEvent[]
  documents         EmployeeDocument[]
  checklist         ChecklistItem[]
  requests          ApprovalRequest[]
  punches           AttendancePunch[]
  days              AttendanceDay[]
  leaveBalances     LeaveBalance[]
  leaveRequests     LeaveRequest[]
  salary            SalaryProfile?
  payslips          Payslip[]
  loans             Loan[]
  expenses          Expense[]
  appraisals        Appraisal[]
  assets            Asset[]            @relation("AssetHolder")

  @@index([branchId])
  @@index([departmentId])
  @@index([managerId])
  @@index([status])
}

/// type: joined | confirmed | promoted | transferred | resigned | exited | rehired | note
model EmployeeEvent {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String
  date       DateTime
  title      String
  details    String? // @text
  byId       String?
  createdAt  DateTime @default(now())

  @@index([employeeId, date])
}

model EmployeeDocument {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         String
  title        String
  path         String    @unique
  size         Int
  expiresAt    DateTime?
  verified     Boolean   @default(true)
  uploadedById String?
  createdAt    DateTime  @default(now())

  @@index([employeeId])
  @@index([expiresAt])
}

/// kind: onboarding | offboarding
model ChecklistItem {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  sortOrder  Int       @default(0)
  doneAt     DateTime?
  doneById   String?

  @@index([employeeId, kind])
}

// ─── Approval engine (shared by profile updates, leave, loans, expenses) ───

/// steps: JSON array of { kind: "manager" | "hr" | "user", userId?: string }
model ApprovalFlow {
  id     String  @id @default(cuid())
  type   String  @unique
  name   String
  steps  String // @text
  active Boolean @default(true)
}

/// status: pending | approved | rejected | cancelled. payload: JSON read by the handler for this type.
model ApprovalRequest {
  id          String           @id @default(cuid())
  type        String
  title       String
  summary     String? // @text
  payload     String // @text
  status      String           @default("pending")
  step        Int              @default(0)
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  requesterId String?
  requester   User?            @relation(fields: [requesterId], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  actions     ApprovalAction[]

  @@index([status, type])
  @@index([employeeId])
}

model ApprovalAction {
  id        String          @id @default(cuid())
  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step      Int
  userId    String?
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  decision  String // approved | rejected | cancelled | submitted
  comment   String?
  createdAt DateTime        @default(now())

  @@index([requestId])
}

// ─── HR: attendance ──────────────────────────────────────────

/// Times are "HH:mm" in company local time. workDays: ISO weekdays, 1 = Monday … 7 = Sunday.
model Shift {
  id         String     @id @default(cuid())
  name       String     @unique
  start      String
  end        String
  graceMin   Int        @default(15)
  halfDayMin Int        @default(240)
  workDays   String     @default("1,2,3,4,5,6")
  isDefault  Boolean    @default(false)
  employees  Employee[]
}

/// branchId null = applies to every branch. date = calendar day (UTC midnight of the local date).
model Holiday {
  id       String   @id @default(cuid())
  date     DateTime
  name     String
  branchId String?

  @@index([date])
}

/// source: web | device | manual
model AttendancePunch {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  at          DateTime
  source      String
  lat         Float?
  lng         Float?
  accuracy    Float?
  distanceM   Int?
  outside     Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([employeeId, at])
  @@index([at])
}

/// status: present | late | half | absent | leave | holiday | weekend | missing (no check-out) | upcoming
model AttendanceDay {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  status      String
  checkIn     DateTime?
  checkOut    DateTime?
  workedMin   Int       @default(0)
  lateMin     Int       @default(0)
  earlyMin    Int       @default(0)
  overtimeMin Int       @default(0)
  note        String?
  corrected   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// ─── HR: leave ───────────────────────────────────────────────

/// quota: days per year (0 + unpaid = unlimited). accrual: annual (pro-rated for new joiners) | monthly (quota/12 per month).
model LeaveType {
  id               String         @id @default(cuid())
  name             String         @unique
  code             String
  color            String         @default("blue")
  paid             Boolean        @default(true)
  quota            Float          @default(0)
  accrual          String         @default("annual")
  carryMax         Float          @default(0)
  halfDay          Boolean        @default(true)
  gender           String?
  minServiceMonths Int            @default(0)
  active           Boolean        @default(true)
  sortOrder        Int            @default(0)
  balances         LeaveBalance[]
  requests         LeaveRequest[]
}

/// Per employee/type/year: carried forward and manual HR adjustments. Used/pending are computed from requests.
model LeaveBalance {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId     String
  type       LeaveType @relation(fields: [typeId], references: [id], onDelete: Cascade)
  year       Int
  carried    Float     @default(0)
  adjusted   Float     @default(0)
  note       String?

  @@unique([employeeId, typeId, year])
}

/// status: pending | approved | rejected | cancelled
model LeaveRequest {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  typeId     String
  type       LeaveType @relation(fields: [typeId], references: [id])
  from       DateTime
  to         DateTime
  halfDay    Boolean   @default(false)
  days       Float
  reason     String?
  status     String    @default("pending")
  approvalId String?   @unique
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([employeeId, from])
  @@index([status])
}

// ─── HR: payroll ─────────────────────────────────────────────

/// An employee's current monthly salary. Components split the gross by percentage.
model SalaryProfile {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  gross         Float
  eobi          Boolean  @default(true)
  pfPct         Float    @default(0)
  taxExempt     Boolean  @default(false)
  effectiveFrom DateTime
  updatedAt     DateTime @updatedAt
}

/// Earning components as % of gross. exemptPctOfBasic: tax-free up to this % of basic (e.g. medical 10%).
model PayComponent {
  id               String  @id @default(cuid())
  name             String  @unique
  pctOfGross       Float
  isBasic          Boolean @default(false)
  exemptPctOfBasic Float?
  sortOrder        Int     @default(0)
}

/// Income tax slabs per fiscal year ("2026-27" = Jul 2026–Jun 2027). Tax = fixed + rate% of income above `from`.
model TaxSlab {
  id         String @id @default(cuid())
  fiscalYear String
  from       Float
  to         Float?
  fixed      Float
  rate       Float

  @@index([fiscalYear])
}

/// status: draft | approved | paid
model PayrollRun {
  id           String              @id @default(cuid())
  month        String              @unique // yyyy-MM
  status       String              @default("draft")
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  payslips     Payslip[]
  adjustments  PayrollAdjustment[]
}

model Payslip {
  id            String        @id @default(cuid())
  runId         String
  run           PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  gross         Float
  earnings      Float
  deductions    Float
  tax           Float
  net           Float
  daysInMonth   Int
  employedDays  Int
  absentDays    Float         @default(0)
  unpaidLeave   Float         @default(0)
  lateCount     Int           @default(0)
  overtimeMin   Int           @default(0)
  designation   String?
  department    String?
  bankName      String?
  accountTitle  String?
  accountNumber String?
  createdAt     DateTime      @default(now())
  lines         PayslipLine[]

  @@unique([runId, employeeId])
}

/// kind: earning | deduction. source: component | overtime | commission | expense | adjustment | absence | late | unpaid | loan | tax | eobi | pf
model PayslipLine {
  id        String  @id @default(cuid())
  payslipId String
  payslip   Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  kind      String
  label     String
  amount    Float
  source    String
  refId     String?
  sortOrder Int     @default(0)
}

/// One-off bonus (+) or deduction (−) for an employee in a run. Survives recalculation.
model PayrollAdjustment {
  id          String     @id @default(cuid())
  runId       String
  run         PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId  String
  label       String
  amount      Float
  taxable     Boolean    @default(true)
  createdById String?
  createdAt   DateTime   @default(now())
}

// ─── HR: loans & expenses ────────────────────────────────────

/// kind: loan | advance. status: pending | active | closed | rejected | cancelled
model Loan {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind        String          @default("loan")
  amount      Float
  installment Float
  startMonth  String // yyyy-MM: first payroll month to deduct
  reason      String?
  status      String          @default("pending")
  approvalId  String?         @unique
  createdAt   DateTime        @default(now())
  repayments  LoanRepayment[]

  @@index([employeeId, status])
}

/// Created when a payroll run is approved (source = run month) or recorded manually by HR.
model LoanRepayment {
  id        String   @id @default(cuid())
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount    Float
  runId     String?
  note      String?
  createdAt DateTime @default(now())
}

/// status: pending | approved | rejected | cancelled | paid. Paid through payroll (payslipId) once a run is approved.
model Expense {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  category    String
  amount      Float
  description String?
  receipt     String?
  status      String   @default("pending")
  approvalId  String?  @unique
  runId       String?
  createdAt   DateTime @default(now())

  @@index([employeeId, status])
}

// ─── HR: recruitment ─────────────────────────────────────────

/// status: open | on_hold | closed
model JobOpening {
  id           String      @id @default(cuid())
  title        String
  departmentId String?
  branchId     String?
  positions    Int         @default(1)
  status       String      @default("open")
  salaryRange  String?
  description  String? // @text
  createdById  String?
  createdAt    DateTime    @default(now())
  candidates   Candidate[]
}

/// stage: applied | screening | interview | offer | hired | rejected
model Candidate {
  id              String      @id @default(cuid())
  openingId       String
  opening         JobOpening  @relation(fields: [openingId], references: [id], onDelete: Cascade)
  name            String
  phone           String?
  email           String?
  source          String?
  cv              String?
  expectedSalary  Float?
  stage           String      @default("applied")
  rating          Int?
  notes           String? // @text
  hiredEmployeeId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  interviews      Interview[]

  @@index([openingId, stage])
}

/// mode: onsite | phone | video. outcome: pass | fail | hold
model Interview {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  at            DateTime
  mode          String    @default("onsite")
  interviewerId String?
  outcome       String?
  feedback      String? // @text
  createdAt     DateTime  @default(now())
}

// ─── HR: performance ─────────────────────────────────────────

/// status: open | closed
model AppraisalCycle {
  id         String      @id @default(cuid())
  name       String
  from       DateTime
  to         DateTime
  status     String      @default("open")
  createdAt  DateTime    @default(now())
  appraisals Appraisal[]
}

/// status: self (waiting for employee) | manager (waiting for reviewer) | done. Ratings 1–5.
model Appraisal {
  id              String         @id @default(cuid())
  cycleId         String
  cycle           AppraisalCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId      String?
  goals           String? // @text
  selfRating      Int?
  selfComments    String? // @text
  managerRating   Int?
  managerComments String? // @text
  recommendation  String? // e.g. increment %, promotion
  status          String         @default("self")
  submittedAt     DateTime?
  completedAt     DateTime?

  @@unique([cycleId, employeeId])
  @@index([reviewerId, status])
}

// ─── HR: assets ──────────────────────────────────────────────

/// status: available | assigned | repair | retired
model Asset {
  id           String     @id @default(cuid())
  tag          String     @unique
  name         String
  category     String
  serial       String?
  cost         Float?
  purchasedAt  DateTime?
  status       String     @default("available")
  assignedToId String?
  assignedTo   Employee?  @relation("AssetHolder", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  notes        String? // @text
  createdAt    DateTime   @default(now())
  logs         AssetLog[]

  @@index([assignedToId])
}

/// action: added | assigned | returned | repair | retired | note
model AssetLog {
  id         String   @id @default(cuid())
  assetId    String
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action     String
  employeeId String?
  note       String?
  byId       String?
  createdAt  DateTime @default(now())

  @@index([assetId])
}

/// Ever-increasing counters (e.g. lead numbers). Only ever incremented, so numbers are never reused.
model Sequence {
  name  String @id
  value Int    @default(0)
}

/// A user's saved list filter (Bitrix-style presets). query is the URL query string.
model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  module    String
  name      String
  query     String // @text
  createdAt DateTime @default(now())

  @@index([userId, module])
}
